// This file is part of www.nand2tetris.org
// Exclusive-or gate: out = 1 when inputs are different.

CHIP Xor {
    IN a, b;
    OUT out;

    PARTS:
    Not(in=a, out=notA);
    Not(in=b, out=notB);
    And(a=a, b=notB, out=term1);
    And(a=notA, b=b, out=term2);
    Or(a=term1, b=term2, out=out);
}
