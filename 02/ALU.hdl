// This file is part of www.nand2tetris.org
// The Hack ALU.

CHIP ALU {
    IN
        x[16], y[16],
        zx, nx, zy, ny, f, no;
    OUT
        out[16],
        zr,
        ng;

    PARTS:
    // If zx=1, set x to zero; then optionally negate x.
    Mux16(a=x, b=false, sel=zx, out=xZeroed);
    Not16(in=xZeroed, out=xNot);
    Mux16(a=xZeroed, b=xNot, sel=nx, out=xPrepared);

    // If zy=1, set y to zero; then optionally negate y.
    Mux16(a=y, b=false, sel=zy, out=yZeroed);
    Not16(in=yZeroed, out=yNot);
    Mux16(a=yZeroed, b=yNot, sel=ny, out=yPrepared);

    // Select bitwise AND or addition.
    And16(a=xPrepared, b=yPrepared, out=andResult);
    Add16(a=xPrepared, b=yPrepared, out=addResult);
    Mux16(a=andResult, b=addResult, sel=f, out=arithmeticResult);

    // Optionally negate the selected result.
    Not16(in=arithmeticResult, out=notResult);
    Mux16(a=arithmeticResult, b=notResult, sel=no, out=out);

    // zr=1 exactly when all output bits are zero.
    Or8Way(in=out[0..7], out=orLow);
    Or8Way(in=out[8..15], out=orHigh);
    Or(a=orLow, b=orHigh, out=anyBitSet);
    Not(in=anyBitSet, out=zr);

    // In 16-bit two's-complement representation, bit 15 is the sign bit.
    And(a=out[15], b=true, out=ng);
}
