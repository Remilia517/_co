// File name: projects/05/CPU.hdl

/**
 * The Hack CPU (Central Processing Unit).
 * Executes A-instructions and C-instructions.
 */

CHIP CPU {
    IN  inM[16],
        instruction[16],
        reset;

    OUT outM[16],
        writeM,
        addressM[15],
        pc[15];

    PARTS:
    // Decode instruction type.
    Not(in=instruction[15], out=isAInstruction);

    // A register: load for A-instructions or C-instructions with dest A.
    And(a=instruction[15], b=instruction[5], out=loadAFromC);
    Or(a=isAInstruction, b=loadAFromC, out=loadA);
    Mux16(a=instruction, b=aluOut, sel=instruction[15], out=aInput);
    ARegister(in=aInput, load=loadA, out=aReg, out[0..14]=addressM);

    // D register: load for C-instructions with dest D.
    And(a=instruction[15], b=instruction[4], out=loadD);
    DRegister(in=aluOut, load=loadD, out=dReg);

    // The ALU's y input is A or M, selected by the a-bit.
    Mux16(a=aReg, b=inM, sel=instruction[12], out=aluY);

    ALU(
        x=dReg,
        y=aluY,
        zx=instruction[11],
        nx=instruction[10],
        zy=instruction[9],
        ny=instruction[8],
        f=instruction[7],
        no=instruction[6],
        out=aluOut,
        out=outM,
        zr=zr,
        ng=ng
    );

    // Assert writeM only for C-instructions with destination M.
    And(a=instruction[15], b=instruction[3], out=writeM);

    // Decode jump conditions: JGT, JEQ, JLT.
    Not(in=ng, out=notNg);
    Not(in=zr, out=notZr);
    And(a=notNg, b=notZr, out=isPositive);
    And(a=instruction[2], b=isPositive, out=jumpJGT);
    And(a=instruction[1], b=zr, out=jumpJEQ);
    And(a=instruction[0], b=ng, out=jumpJLT);
    Or(a=jumpJGT, b=jumpJEQ, out=jumpJGTorJEQ);
    Or(a=jumpJGTorJEQ, b=jumpJLT, out=jumpCondition);
    And(a=instruction[15], b=jumpCondition, out=loadPC);

    // PC increments normally, loads A on a taken jump, or resets to zero.
    PC(in=aReg, load=loadPC, inc=true, reset=reset, out[0..14]=pc);
}
