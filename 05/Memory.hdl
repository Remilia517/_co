// File name: projects/05/Memory.hdl

/**
 * The complete address space of the Hack computer's memory,
 * including RAM and memory-mapped I/O.
 */

CHIP Memory {
    IN in[16], load, address[15];
    OUT out[16];

    PARTS:
    // RAM occupies addresses 0x0000-0x3FFF.
    Not(in=address[14], out=notAddress14);
    And(a=load, b=notAddress14, out=loadRAM);
    RAM16K(in=in, load=loadRAM, address=address[0..13], out=ramOut);

    // Screen occupies addresses 0x4000-0x5FFF.
    Not(in=address[13], out=notAddress13);
    And(a=load, b=address[14], out=loadHighRegion);
    And(a=loadHighRegion, b=notAddress13, out=loadScreen);
    Screen(in=in, load=loadScreen, address=address[0..12], out=screenOut);

    // Keyboard is mapped at address 0x6000 and is read-only.
    Keyboard(out=keyboardOut);

    // Select RAM or Screen, then select Keyboard at 0x6000.
    Mux16(a=ramOut, b=screenOut, sel=address[14], out=ramOrScreenOut);
    And(a=address[14], b=address[13], out=isKeyboardAddress);
    Mux16(a=ramOrScreenOut, b=keyboardOut, sel=isKeyboardAddress, out=out);
}
