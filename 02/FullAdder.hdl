// This file is part of www.nand2tetris.org
// Computes the sum of three bits.

CHIP FullAdder {
    IN a, b, c;
    OUT sum, carry;

    PARTS:
    HalfAdder(a=a, b=b, sum=partialSum, carry=carryAB);
    HalfAdder(a=partialSum, b=c, sum=sum, carry=carryC);
    Or(a=carryAB, b=carryC, out=carry);
}
